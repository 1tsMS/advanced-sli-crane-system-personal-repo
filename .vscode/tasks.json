{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SLI Backend (FastAPI)",
      "type": "shell",
      "command": "python main.py",
      "options": {
        "cwd": "${workspaceFolder}/software/sli_desktop/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "group": "sli-desktop"
      }
    },
    {
      "label": "SLI Dashboard (Vite UI)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/software/sli_desktop/dashboard"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "group": "sli-desktop"
      }
    },
    {
      "label": "Launch SLI Desktop",
      "dependsOn": [
        "SLI Backend (FastAPI)",
        "SLI Dashboard (Vite UI)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
